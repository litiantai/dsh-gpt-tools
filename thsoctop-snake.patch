new file mode 100644
index 0000000..39a06fb
--- /dev/null
+++ b/packages/dsh-games/src/client/snake-hud.ts
@@ -0,0 +1,104 @@
+/**
+ * 贪吃蛇的「渲染摘要」（view-model）：把可变世界压成一份可比较的纯数据。
+ *
+ * 为什么单独一个文件、而且**一个 import 都不许有**：
+ *  - 它是「棋盘什么时候需要重绘」的唯一判据，必须能被单测直接锁住；
+ *  - 视图文件 import 了 react，而本包的测试跑在 node 环境、没有 react 依赖，
+ *    把这段逻辑留在视图里就没法测（这正是当初漏掉「普通移动不重绘」那个 bug 的原因）。
+ *
+ * 关键约束：签名必须覆盖**所有会改变画面的状态**。React 只在 state 变化时重渲染，
+ * 而棋盘是从可变 world 引用上读的；签名漏掉任何一项，那种变化就不会触发重绘。
+ */
+import {
+  occupancy,
+  progressOf,
+  type Dir,
+  type DifficultyKey,
+  type EndReason,
+  type Phase,
+  type Point,
+  type World,
+} from './snake.js'
+
+export interface Hud {
+  phase: Phase
+  score: number
+  length: number
+  difficulty: DifficultyKey
+  high: number
+  progress: number
+  eaten: number
+  reason?: EndReason
+  /**
+   * 下面这组字段不显示在 HUD 上，但它们决定棋盘画什么：
+   * steps 覆盖「走了一步」，dir 覆盖「还没走但已转向」，foodKey 覆盖「重开/吃到后
+   * 换了食物位置」，goldKey 覆盖「金苹果出现或超时消失」。
+   * 它们是离散逻辑步的结果，所以刷新频率是「一步一次」，不是 60fps。
+   */
+  steps: number
+  /**
+   * 棋盘上「现在朝哪边」：有已按键但还没生效的转向时取那个方向。
+   *
+   * 为什么不用 `world.dir`：引擎要等这一步真正走完才改 dir（否则会在走之前就撞死），
+   * 但玩家已经按键了，蛇头眼睛应该立刻转过去，所见即所得。
+   */
+  facing: Dir
+  foodKey: string
+  goldKey: string
+}
+
+/** 渲染朝向 = 输入缓冲里最后一个待生效方向，没有就是当前方向。 */
+export function facingOf(world: World): Dir {
+  const queued = world.queue[world.queue.length - 1]
+  return queued ?? world.dir
+}
+
+export const PHASE_LABEL: Readonly<Record<Phase, string>> = {
+  ready: '准备开始',
+  playing: '进行中',
+  paused: '已暂停',
+  over: '本局结束',
+  won: '通关！',
+}
+
+export const REASON_LABEL: Readonly<Record<EndReason, string>> = {
+  wall: '撞到墙了',
+  self: '咬到自己了',
+  'win-board': '蛇填满了整个盘面',
+  'win-score': '达成分数目标',
+}
+
+/** 格子坐标压成字符串；空位用 '-'，DOM 里也用它当调试标记。 */
+export function cellKey(point: Point | undefined): string {
+  return point === undefined ? '-' : `${String(point.x)},${String(point.y)}`
+}
+
+/**
+ * 读一份渲染摘要。
+ * @param world - 当前世界（可变引用，原地更新）。
+ * @param high - 当前难度的最高分。
+ */
+export function readHud(world: World, high: number): Hud {
+  return {
+    phase: world.phase,
+    score: world.score,
+    length: occupancy(world),
+    difficulty: world.difficulty,
+    high,
+    progress: progressOf(world),
+    eaten: world.eaten,
+    reason: world.reason,
+    steps: world.steps,
+    facing: facingOf(world),
+    foodKey: cellKey(world.food),
+    goldKey: cellKey(world.gold),
+  }
+}
+
+/** 摘要签名：只要它变了就 setState 重渲染棋盘。 */
+export function hudSignature(hud: Hud): string {
+  return [
+    hud.phase, hud.score, hud.length, hud.difficulty, hud.high, hud.progress, hud.eaten,
+    hud.reason ?? '', hud.steps, hud.facing, hud.foodKey, hud.goldKey,
+  ].join('|')
+}
