index 0000000..ebeb559
--- /dev/null
+++ b/packages/dsh-games/src/client/snake-view.tsx
@@ -0,0 +1,578 @@
+/**
+ * 贪吃蛇面板：SVG 棋盘 + requestAnimationFrame 循环。
+ *
+ * 分工和 plane-view 一样：snake.ts 决定「世界怎么变」，这里只决定「世界怎么画」和
+ * 「输入怎么收」。世界对象是可变引用，不在 state 里，所以 60fps 不会触发 60 次重渲染；
+ * 只有 HUD 摘要（阶段/得分/长度/难度）变了才 setState。
+ *
+ * 键盘只挂在游戏舞台元素上（tabIndex=0），不是 window：面板里翻别的 Tab、或者在页面
+ * 其它地方打字，都不会误触贪吃蛇。焦点离开时清空输入队列，避免「回来还在转」。
+ *
+ * 生命周期：rAF、键盘、visibilitychange、IntersectionObserver 在卸载时全部清理；
+ * 面板不可见（切 Tab / 切窗口 / 滚出视口）自动暂停。
+ */
+import { useEffect, useRef, useState, type ReactNode } from 'react'
+import {
+  DIFFICULTIES,
+  FOOD_SCORE,
+  GOLD_EVERY,
+  GOLD_SCORE,
+  beginRun,
+  createWorld,
+  difficultyOf,
+  emptyHighScores,
+  recordHighScore,
+  setDifficulty as applyDifficulty,
+  tick,
+  togglePause,
+  turn,
+  type Dir,
+  type DifficultyKey,
+  type Point,
+  type World,
+} from './snake.js'
+import {
+  PHASE_LABEL,
+  REASON_LABEL,
+  cellKey,
+  hudSignature,
+  readHud,
+  type Hud,
+} from './snake-hud.js'
+
+/** 一个格子在 viewBox 里的边长；网格用 pattern 画，蛇身用 1×1 的圆角矩形。 */
+const CELL = 1
+const PAD = 1
+/** 蛇身圆角半径（相对格子边长） */
+const SEG_RADIUS = 0.3
+
+/** 每个方向按钮的位移，用来显示方向图标。 */
+const DIR_PAD: readonly { readonly dir: Dir; readonly glyph: string; readonly label: string }[] = [
+  { dir: 'up', glyph: '▲', label: '向上' },
+  { dir: 'left', glyph: '◀', label: '向左' },
+  { dir: 'right', glyph: '▶', label: '向右' },
+  { dir: 'down', glyph: '▼', label: '向下' },
+]
+
+/** 蛇身颜色：蛇头用 brand，往后逐渐变浅（用 opacity 表达，避免依赖具体色值）。 */
+function segmentOpacity(index: number, total: number): number {
+  if (total <= 1) return 1
+  return 1 - (index / total) * 0.55
+}
+
+export function SnakePanel({ hidden = false }: { readonly hidden?: boolean }): ReactNode {
+  const stageRef = useRef<HTMLDivElement | null>(null)
+  const worldRef = useRef<World | null>(null)
+  if (worldRef.current === null) worldRef.current = createWorld('standard')
+  // 世界对象只建一次、之后原地更新，所以这个引用全程有效
+  const world: World = worldRef.current
+
+  const [hud, setHud] = useState<Hud>(() => readHud(world, 0))
+  const [highScores, setHighScores] = useState<Record<DifficultyKey, number>>(emptyHighScores)
+  const [newRecord, setNewRecord] = useState(false)
+
+  const hudRef = useRef(hud)
+  hudRef.current = hud
+  const highRef = useRef(highScores)
+  highRef.current = highScores
+  const visibleRef = useRef(true)
+  const reducedRef = useRef(false)
+  /** 已经结算过的那一局（签名 = 本局步数/得分/结果），保证最高分只记一次 */
+  const settledRef = useRef('')
+
+  const syncHud = (): void => {
+    const next = readHud(world, highRef.current[world.difficulty])
+    if (hudSignature(next) !== hudSignature(hudRef.current)) {
+      hudRef.current = next
+      setHud(next)
+    }
+  }
+
+  /**
