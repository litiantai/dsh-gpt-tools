+/**
+ * 贪吃蛇引擎：整局游戏都在这里，纯逻辑，不碰 DOM / requestAnimationFrame / 定时器。
+ *
+ * 与 plane.ts 同一套路：世界是一个可变对象，`tick(world, dtMs, rng)` 每次推进一帧，
+ * 视图片只负责画和收输入。好处是单测可以直接「快进」「构造一个只剩一格的盘面」
+ * 来验证撞墙、撞身体、穿墙、满盘胜利，不用起浏览器。
+ *
+ * 时间粒度是「步」：世界自己攒 accMs，攒够一步才移动一格，所以帧率高低不影响手感
+ * （每帧最多补偿 MAX_STEPS_PER_TICK 步，防止切回前台时一帧冲出去撞死）。
+ */
+
+export const GRID = { width: 17, height: 17 } as const
+export const CELLS = GRID.width * GRID.height
+/** 起点蛇长 */
+export const START_LENGTH = 3
+/** 单帧最多补偿的步数：卡顿/切回前台后的追赶上限 */
+export const MAX_STEPS_PER_TICK = 8
+/** 输入缓冲深度：连按两下可以连续转两个 90°，但缓冲不会无限增长 */
+export const MAX_QUEUED_TURNS = 2
+/** 普通食物 10 分 */
+export const FOOD_SCORE = 10
+/** 金苹果 30 分，且有存活时限 */
+export const GOLD_SCORE = 30
+export const GOLD_TTL_MS = 6000
+/** 每吃掉几个普通食物掷一次金苹果 */
+export const GOLD_EVERY = 3
+/** 单步间隔下限（毫秒），避免高分局快到无法操作 */
+export const MIN_STEP_MS = 60
+
+export type DifficultyKey = 'casual' | 'standard' | 'master'
+export type Phase = 'ready' | 'playing' | 'paused' | 'over' | 'won'
+export type EndReason = 'wall' | 'self' | 'win-board' | 'win-score'
+export type Dir = 'up' | 'down' | 'left' | 'right'
+
+export interface GridSpec {
+  readonly width: number
+  readonly height: number
+}
+
+export interface DifficultySpec {
+  readonly key: DifficultyKey
+  readonly label: string
+  readonly hint: string
+  /** 盘面大小：越难越大 */
+  readonly grid: GridSpec
+  /** 初始「每走一格」的毫秒数，越大越慢 */
+  readonly startMs: number
+  /** 每吃到一个食物，步进间隔乘以这个系数 */
+  readonly speedUp: number
+  /** 间隔下限 */
+  readonly minMs: number
+  /** 撞墙是否穿墙（悠闲档穿墙，另外两档直接结束） */
+  readonly wrap: boolean
+  /** 金苹果出现概率 */
+  readonly goldChance: number
+  /** 分数目标：达成即胜利（满盘胜利之外的第二个胜利条件） */
+  readonly scoreTarget: number
+}
+
+export const DIFFICULTIES: readonly DifficultySpec[] = [
+  {
+    key: 'casual',
+    label: '悠闲',
+    hint: '15×15 小盘、慢速、撞墙穿墙，随便撞也不死',
+    grid: { width: 15, height: 15 },
+    startMs: 200,
+    speedUp: 0.985,
+    minMs: 120,
+    wrap: true,
+    goldChance: 0.5,
+    scoreTarget: 200,
+  },
+  {
+    key: 'standard',
+    label: '标准',
+    hint: '17×17、中速、撞墙即结束，标准玩法',
+    grid: { width: 17, height: 17 },
+    startMs: 150,
+    speedUp: 0.98,
+    minMs: 90,
+    wrap: false,
+    goldChance: 0.4,
+    scoreTarget: 300,
+  },
+  {
+    key: 'master',
+    label: '大师',
+    hint: '19×19 大盘、起步就快、越吃越快，容错极低',
+    grid: { width: 19, height: 19 },
+    startMs: 105,
+    speedUp: 0.975,
+    minMs: 62,
+    wrap: false,
+    goldChance: 0.32,
+    scoreTarget: 450,
+  },
+]
+
+/** 找不到就回落到标准档，绝不返回 undefined。 */
+export function difficultyOf(key: DifficultyKey): DifficultySpec {
+  return DIFFICULTIES.find((item) => item.key === key) ?? DIFFICULTIES[1]!
+}
+
+export interface Point {
+  x: number
+  y: number
+}
+
+export interface World {
+  difficulty: DifficultyKey
+  /** 盘面尺寸：改难度会整体重开，所以它在一局内恒定（对象本身是冻结的） */
+  grid: GridSpec
+  /** 总格数，胜利判定用 */
+  cellCount: number
+  /** 蛇身，[0] 是头 */
+  snake: Point[]
+  dir: Dir
+  queue: Dir[]
+  food: Point
+  gold?: Point
+  goldLeftMs: number
+  score: number
+  eaten: number
+  /** 当前每步毫秒数，吃到食物会变小 */
+  stepMs: number
+  accMs: number
+  elapsedMs: number
+  steps: number
+  phase: Phase
+  reason?: EndReason
+}
+
+/** 四方向位移。 */
+const DELTA: Readonly<Record<Dir, Point>> = {
+  up: { x: 0, y: -1 },
+  down: { x: 0, y: 1 },
+  left: { x: -1, y: 0 },
+  right: { x: 1, y: 0 },
+}
+
+const OPPOSITE: Readonly<Record<Dir, Dir>> = {
+  up: 'down',
+  down: 'up',
+  left: 'right',
+  right: 'left',
+}
+
+function samePoint(a: Point, b: Point): boolean {
+  return a.x === b.x && a.y === b.y
+}
+
+function keyOf(point: Point): string {
+  return `${String(point.x)},${String(point.y)}`
+}
+
+function clampPoint(point: Point, grid: GridSpec): Point {
+  return {
+    x: Math.min(grid.width - 1, Math.max(0, point.x)),
+    y: Math.min(grid.height - 1, Math.max(0, point.y)),
+  }
+}
+
+/** 盘面上除了蛇身（以及显式排除的格子）以外的空格。 */
+function freeCells(snake: readonly Point[], grid: GridSpec, exclude?: Point): Point[] {
+  const taken = new Set(snake.map(keyOf))
+  if (exclude !== undefined) taken.add(keyOf(exclude))
+  const free: Point[] = []
+  for (let y = 0; y < grid.height; y += 1) {
+    for (let x = 0; x < grid.width; x += 1) {
+      if (!taken.has(keyOf({ x, y }))) free.push({ x, y })
+    }
+  }
+  return free
+}
+
+/** 从空格里随机挑一个；没有空格返回 undefined（调用方负责判定胜利）。 */
+function pickFreeCell(
+  snake: readonly Point[],
+  grid: GridSpec,
+  rng: () => number,
+  exclude?: Point,
+): Point | undefined {
+  const free = freeCells(snake, grid, exclude)
+  if (free.length === 0) return undefined
+  const index = Math.min(free.length - 1, Math.max(0, Math.floor(rng() * free.length)))
+  return free[index]
+}
+
+/** 贪吃蛇开局都是横着一条，头在右 —— 这样「向上/向下」都是合法首步。 */
+function makeSnake(grid: GridSpec): Point[] {
+  const midY = Math.floor(grid.height / 2)
+  const headX = Math.floor(grid.width / 2)
+  return Array.from({ length: START_LENGTH }, (_, i) => ({
+    x: Math.max(0, headX - i),
+    y: midY,
+  }))
+}
+
+/** 把 world 原地重置成一局新游戏（createWorld / beginRun / setDifficulty 共用）。 */
+function reset(world: World, key: DifficultyKey, rng: () => number, grid?: GridSpec): void {
+  const spec = difficultyOf(key)
+  const size = grid ?? spec.grid
+  world.difficulty = key
+  world.grid = Object.freeze({ width: size.width, height: size.height })
+  world.cellCount = size.width * size.height
+  world.snake = makeSnake(world.grid)
+  world.dir = 'right'
+  world.queue = []
+  world.gold = undefined
+  world.goldLeftMs = 0
+  world.score = 0
+  world.eaten = 0
+  world.stepMs = spec.startMs
+  world.accMs = 0
+  world.elapsedMs = 0
+  world.steps = 0
+  world.phase = 'ready'
+  delete world.reason
+  world.food = pickFreeCell(world.snake, world.grid, rng) ?? { x: 0, y: 0 }
+}
+
+/**
+ * 建一局新游戏。
+ * @param difficulty - 难度档位，默认标准。
+ * @param grid - 覆盖盘面尺寸（单测用，UI 不传）。
+ * @param rng - 随机源，默认 Math.random；单测注入固定序列。
+ */
+export function createWorld(
+  difficulty: DifficultyKey = 'standard',
+  grid?: GridSpec,
+  rng: () => number = Math.random,
+): World {
+  const spec = difficultyOf(difficulty)
+  const size = grid ?? spec.grid
+  const world: World = {
+    difficulty,
+    grid: Object.freeze({ width: size.width, height: size.height }),
+    cellCount: size.width * size.height,
+    snake: [],
+    dir: 'right',
+    queue: [],
+    food: { x: 0, y: 0 },
+    goldLeftMs: 0,
+    score: 0,
+    eaten: 0,
+    stepMs: spec.startMs,
+    accMs: 0,
+    elapsedMs: 0,
+    steps: 0,
+    phase: 'ready',
+  }
+  reset(world, difficulty, rng, grid)
+  return world
+}
+
+/** 开一局（可以在 ready/over/won/paused 任意阶段调用，等于重新开始）。 */
+export function beginRun(world: World, difficulty?: DifficultyKey, grid?: GridSpec, rng: () => number = Math.random): World {
+  reset(world, difficulty ?? world.difficulty, rng, grid)
+  world.phase = 'playing'
+  return world
+}
+
+/** 换难度：会带着新盘面重新开一局。 */
+export function setDifficulty(world: World, key: DifficultyKey, rng: () => number = Math.random): World {
+  reset(world, key, rng)
+  return world
+}
+
+/** 待生效的转向数量，HUD 用来提示输入缓冲。 */
+export function pendingTurns(world: World): number {
+  return world.queue.length
+}
+
+/**
+ * 请求转向。反向（180°）会被拒绝，也不会重复塞同一个方向。
+ * @returns 是否被接受。
+ */
+export function turn(world: World, dir: Dir): boolean {
+  if (world.phase !== 'playing') return false
+  const queue = world.queue
+  if (queue.length >= MAX_QUEUED_TURNS) return false
+  const base = queue.length > 0 ? queue[queue.length - 1]! : world.dir
+  if (dir === base) return false
+  if (dir === OPPOSITE[base]) return false
+  queue.push(dir)
+  return true
+}
+
+/** 暂停 / 继续。ready / over / won 阶段调用无效果。 */
+export function togglePause(world: World): boolean {
+  if (world.phase === 'playing') {
+    world.phase = 'paused'
+    return true
+  }
+  if (world.phase === 'paused') {
+    world.phase = 'playing'
+    return true
+  }
+  return false
+}
+
+/** 已经占用的格数（含蛇身与食物，用于显示「吃满全场」进度）。 */
+export function occupancy(world: World): number {
+  return world.snake.length
+}
+
+/** 本局的目标进度 0~1：分数目标与满盘目标取更接近完成的那个。 */
+export function progressOf(world: World): number {
+  const spec = difficultyOf(world.difficulty)
+  const byScore = spec.scoreTarget > 0 ? world.score / spec.scoreTarget : 0
+  const byBoard = world.cellCount > 0 ? world.snake.length / world.cellCount : 0
+  return Math.min(1, Math.max(byScore, byBoard))
+}
+
+/**
+ * 走一步。返回 'moved' | 'ate' | 'over' | 'won'。
+ *
+ * 顺序：取方向 → 算新头 → 撞墙 → 撞自己 → 吃食物 → 判定胜利。
+ * 撞自己时不算尾巴那一格：尾巴这一步会让位，所以追着尾巴走不会死。
+ */
+function step(world: World, rng: () => number): 'moved' | 'ate' | 'over' | 'won' {
+  const grid = world.grid
+
+  let dir = world.dir
+  while (world.queue.length > 0) {
+    const next = world.queue.shift()!
+    if (next !== dir && next !== OPPOSITE[dir]) {
+      dir = next
+      break
+    }
+  }
+  world.dir = dir
+
+  const delta = DELTA[dir]
+  const raw: Point = { x: world.snake[0]!.x + delta.x, y: world.snake[0]!.y + delta.y }
+  const outside = raw.x < 0 || raw.y < 0 || raw.x >= grid.width || raw.y >= grid.height
+
+  let head: Point
+  if (outside) {
+    const spec = difficultyOf(world.difficulty)
+    if (!spec.wrap) {
+      world.phase = 'over'
+      world.reason = 'wall'
+      return 'over'
+    }
+    head = { x: (raw.x + grid.width) % grid.width, y: (raw.y + grid.height) % grid.height }
+  } else {
+    head = raw
+  }
+
+  const ateFood = samePoint(head, world.food)
+  const ateGold = world.gold !== undefined && samePoint(head, world.gold)
+
+  // 只有普通食物让蛇变长；金苹果只加分，尾巴照常让位。
+  // 也正因为如此，吃东西时尾巴不让位 → 判撞身体要连尾巴一起算。
+  const body = ateFood ? world.snake : world.snake.slice(0, -1)
+  if (body.some((segment) => samePoint(segment, head))) {
+    world.phase = 'over'
+    world.reason = 'self'
+    return 'over'
+  }
+
+  // 头进：吃到普通食物就保留尾巴（净长 +1），否则把尾巴裁掉（净长不变）
+  world.snake.unshift(head)
+  world.steps += 1
+
+  if (ateFood) {
+    world.score += FOOD_SCORE
+    world.eaten += 1
+    const spec = difficultyOf(world.difficulty)
+    world.stepMs = Math.max(spec.minMs, Math.round(world.stepMs * spec.speedUp))
+    const next = pickFreeCell(world.snake, grid, rng)
+    if (next === undefined) {
+      // 盘面已被蛇填满：这一口就是最后一格
+      world.phase = 'won'
+      world.reason = 'win-board'
+      return 'won'
+    }
+    world.food = next
+  } else if (ateGold) {
+    world.gold = undefined
+    world.goldLeftMs = 0
+    world.score += GOLD_SCORE
+    world.snake.pop()
+  } else {
+    world.snake.pop()
+  }
+
+  // 金苹果：每吃 GOLD_EVERY 个普通食物掷一次，且不压在食物那一格上
+  if (ateFood && world.eaten % GOLD_EVERY === 0 && world.gold === undefined) {
+    const spec = difficultyOf(world.difficulty)
+    if (rng() < spec.goldChance) {
+      const spot = pickFreeCell(world.snake, grid, rng, world.food)
+      if (spot !== undefined) {
+        world.gold = spot
+        world.goldLeftMs = GOLD_TTL_MS
+      }
+    }
+  }
+
+  if (world.score >= difficultyOf(world.difficulty).scoreTarget) {
+    world.phase = 'won'
+    world.reason = 'win-score'
+    return 'won'
+  }
+
+  return ateFood ? 'ate' : 'moved'
+}
+
+/** 单帧最长计入的时间：切回前台时一帧可能带进来好几秒，先截断再归一化。 */
+export const MAX_FRAME_MS = 1000
+
+/**
+ * 把帧间隔归一化成安全的毫秒数：非有限值（NaN / ±Infinity）与负数一律按 0，
+ * 超过 MAX_FRAME_MS 的截断。
+ *
+ * 关键点：`Math.max(0, NaN)` 的结果是 NaN，直接用它会把 accMs / elapsedMs /
+ * goldLeftMs 污染成 NaN，之后 `accMs >= stepMs` 永远为 false —— 游戏会静默卡死。
+ */
+function safeDelta(dtMs: number): number {
+  if (!Number.isFinite(dtMs)) return 0
+  if (dtMs <= 0) return 0
+  return Math.min(dtMs, MAX_FRAME_MS)
+}
+
+/**
+ * 推进一帧。
+ * @param dtMs - 距上一帧的毫秒数；非有限值与负数按 0 处理，并截断到 MAX_FRAME_MS。
+ * @param rng - 随机源，默认 Math.random。
+ * @returns 本帧实际走的步数。
+ */
+export function tick(world: World, dtMs: number, rng: () => number = Math.random): number {
+  const safeDt = safeDelta(dtMs)
+  if (world.phase === 'playing') world.elapsedMs += safeDt
+  if (world.phase !== 'playing') return 0
+
+  if (world.goldLeftMs > 0) {
+    world.goldLeftMs -= safeDt
+    if (world.goldLeftMs <= 0) {
+      world.goldLeftMs = 0
+      world.gold = undefined
+    }
+  }
+
+  world.accMs += safeDt
+  let moved = 0
+  while (world.accMs >= world.stepMs && moved < MAX_STEPS_PER_TICK && world.phase === 'playing') {
+    world.accMs -= world.stepMs
+    const outcome = step(world, rng)
+    moved += 1
+    if (outcome === 'over' || outcome === 'won') {
+      world.accMs = 0
+      break
+    }
+  }
+  // 掉帧太多时丢弃攒下的时间，别让它滚雪球
+  if (world.accMs > world.stepMs * MAX_STEPS_PER_TICK) world.accMs = 0
+  return moved
+}
+
+/** 给视图片用：把蛇头摆在盘内（穿墙后 head 一定在盘内，这里只是保险）。 */
+export function headOf(world: World): Point {
+  return clampPoint(world.snake[0] ?? { x: 0, y: 0 }, world.grid)
+}
+
+/** 各难度最高分（本次会话内存内，不落盘）。 */
+export function emptyHighScores(): Record<DifficultyKey, number> {
+  return { casual: 0, standard: 0, master: 0 }
+}
+
+/** 刷新最高分，返回新对象（便于 React setState）。 */
+export function recordHighScore(
+  scores: Readonly<Record<DifficultyKey, number>>,
+  key: DifficultyKey,
+  score: number,
+): Record<DifficultyKey, number> {
+  const best = scores[key] ?? 0
+  if (score <= best) return { ...scores }
+  return { ...scores, [key]: score }
+}
