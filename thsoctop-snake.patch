+    expect(world.snake).toHaveLength(START_LENGTH)
+  })
+
+  it('occupancy 等于蛇长', () => {
+    const world = started()
+    expect(occupancy(world)).toBe(world.snake.length)
+  })
+})
+
+describe('最高分（本次会话内存内）', () => {
+  it('初始三档都是 0', () => {
+    expect(emptyHighScores()).toEqual({ casual: 0, standard: 0, master: 0 })
+  })
+
+  it('按难度分桶记录，且只在更高时才更新', () => {
+    let scores = emptyHighScores()
+    scores = recordHighScore(scores, 'standard', 120)
+    expect(scores.standard).toBe(120)
+    expect(scores.casual).toBe(0)
+
+    const lower = recordHighScore(scores, 'standard', 80)
+    expect(lower.standard).toBe(120)
+
+    const higher = recordHighScore(scores, 'standard', 200)
+    expect(higher.standard).toBe(200)
+    // 返回新对象，便于 React setState 触发更新
+    expect(higher).not.toBe(scores)
+  })
+})
+
+describe('棋盘重绘触发（hudSignature 必须覆盖所有会改变画面的状态）', () => {
+  it('普通移动一格就会换签名（否则 SVG 会停在原地）', () => {
+    const world = started()
+    world.food = { x: 0, y: world.grid.height - 1 }
+    const before = hudSignature(readHud(world, 0))
+
+    stepOnce(world)
+
+    const after = readHud(world, 0)
+    expect(after.steps).toBe(world.steps)
+    expect(hudSignature(after)).not.toBe(before)
+  })
+
+  it('只按方向键、还没走的那一步也会换签名（蛇头朝向立刻转过去）', () => {
+    const world = started()
+    const before = readHud(world, 0)
+    expect(before.facing).toBe('right')
+
+    expect(turn(world, 'up')).toBe(true)
+
+    const after = readHud(world, 0)
+    // 引擎要等这一步走完才改 world.dir（走之前改会在移动前就撞死），
+    // 但渲染朝向必须立刻跟上玩家按键
+    expect(world.dir).toBe('right')
+    expect(after.facing).toBe('up')
+    expect(after.steps).toBe(0)
+    expect(hudSignature(after)).not.toBe(hudSignature(before))
+  })
+
+  it('重开时即使分数与难度都一样，食物换位置也必须换签名', () => {
+    // 固定 rng 让两局的蛇一致：食物位置由 rng 决定，这里强制换个位置来模拟「重开换食」
+    const world = started()
+    const first = readHud(world, 0)
+
+    beginRun(world, 'standard', undefined, noGold)
+    world.food = { x: 0, y: 0 }
+    const afterRestart = readHud(world, 0)
+
+    // 分数、难度、蛇长都一样，只有食物位置变了
+    expect(afterRestart.score).toBe(first.score)
+    expect(afterRestart.difficulty).toBe(first.difficulty)
+    expect(afterRestart.length).toBe(first.length)
+    expect(afterRestart.foodKey).not.toBe(first.foodKey)
+    expect(hudSignature(afterRestart)).not.toBe(hudSignature(first))
+  })
+
+  it('金苹果出现与超时消失都会换签名', () => {
+    const world = started()
+    world.food = { x: 0, y: world.grid.height - 1 }
+    const noGoldYet = hudSignature(readHud(world, 0))
+
+    world.gold = { x: 0, y: 0 }
+    world.goldLeftMs = 900
+    const withGold = readHud(world, 0)
+    expect(withGold.goldKey).toBe('0,0')
+    expect(hudSignature(withGold)).not.toBe(noGoldYet)
+
+    // 到点消失（900ms < 单帧上限，一帧即过期）
+    tick(world, 900, noGold)
+    const gone = readHud(world, 0)
+    expect(world.gold).toBeUndefined()
+    expect(gone.goldKey).toBe('-')
+    expect(hudSignature(gone)).not.toBe(hudSignature(withGold))
+  })
+
+  it('金苹果存活时间超过单帧上限时，需要多帧才会过期（截断仍然生效）', () => {
+    const world = started()
+    world.food = { x: 0, y: world.grid.height - 1 }
+    world.gold = { x: 0, y: 0 }
+    // 存活时间大于单帧上限：第一次 tick 只扣掉截断后的 MAX_FRAME_MS
+    world.goldLeftMs = MAX_FRAME_MS + 500
+
+    tick(world, MAX_FRAME_MS * 3, noGold)
+    expect(world.gold).toBeDefined()
+    expect(world.goldLeftMs).toBe(500)
+
+    tick(world, 600, noGold)
+    expect(world.gold).toBeUndefined()
+  })
+
+  it('状态没变时签名稳定，避免无意义重渲染', () => {
+    const world = started()
+    const first = hudSignature(readHud(world, 0))
+    expect(hudSignature(readHud(world, 0))).toBe(first)
+  })
+})
+
+describe('类型约束', () => {
+  it('tick 返回步数、turn 返回布尔，世界对象类型稳定', () => {
+    expectTypeOf(tick).returns.toBeNumber()
+    expectTypeOf(turn).returns.toBeBoolean()
+    expectTypeOf(createWorld).returns.toEqualTypeOf<World>()
+    expectTypeOf<Dir>().toEqualTypeOf<'up' | 'down' | 'left' | 'right'>()
+  })
+})
